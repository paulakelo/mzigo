{
  "name": "mzigo-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "plugin.name": "pgoutput",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "mzigo_user",
    "database.password": "mzigo_password",
    "database.dbname": "mzigo",
    "topic.prefix": "mzigo",
    "table.include.list": "public.zones,public.shops,public.customers,public.riders,public.deliveries,public.delivery_status_events,public.rider_locations",
    "tombstones.on.delete": "false",
    "decimal.handling.mode": "double",
    "time.precision.mode": "connect"
  }
}
